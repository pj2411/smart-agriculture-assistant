# JalSaathi LLM (server-side only)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Separate Gnani/Vachana credentials for speech input/output
STT_PROVIDER=gnani
TTS_PROVIDER=gnani
GNANI_STT_API_KEY_ID=
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_API_KEY=
GNANI_TTS_ENDPOINT=https://api.gnani.ai/v1/tts/inference
GNANI_TTS_MODEL=timbre-2.5
GNANI_TTS_VOICE=Deepak
# Optional per-language overrides; automatic mapping is used when blank.
GNANI_TTS_LANGUAGE_HI_IN=
GNANI_TTS_LANGUAGE_EN_IN=
GNANI_TTS_LANGUAGE_PA_IN=
GNANI_TTS_LANGUAGE_BN_IN=
GNANI_TTS_LANGUAGE_MR_IN=

# Allowed CORS Origins (comma-separated, add your Vercel URL when deploying)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Port for local or server hosting
PORT=8000

# Optional Hugging Face Hub repository containing pre-trained .keras models
HF_REPO_ID=

# Optional direct URL where .keras models are hosted
MODEL_BASE_URL=

# JalSaathi simulator and safety flags
DEFAULT_LANGUAGE=hi-IN
CLIMATE_SCENARIOS_ENABLED=true
CLIMATE_SCENARIOS_PATH=../data/climate_test_scenarios.json
DEVICE_INGEST_ENABLED=false
DEVICE_CONTROL_ENABLED=false
MAX_AUDIO_UPLOAD_MB=10

# Supabase Auth verification (server-side)
SUPABASE_URL=https://ziwcmzxxnialejaifuab.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional future database/admin work only; never expose this to frontend.
SUPABASE_SERVICE_ROLE_KEY=
JALSAATHI_LOCAL_DEMO_AUTH=false
