# Gemini API Configuration
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# JalSaathi provider configuration (server-side only)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
STT_PROVIDER=gnani
TTS_PROVIDER=gnani
GNANI_STT_API_KEY_ID=
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_API_KEY=
GNANI_TTS_ENDPOINT=https://api.gnani.ai/v1/tts/inference
GNANI_TTS_MODEL=timbre-2.5
GNANI_TTS_VOICE=Deepak
# Optional per-language overrides; automatic mapping is used when blank.
GNANI_TTS_LANGUAGE_HI_IN=
GNANI_TTS_LANGUAGE_EN_IN=
GNANI_TTS_LANGUAGE_PA_IN=
GNANI_TTS_LANGUAGE_BN_IN=
GNANI_TTS_LANGUAGE_MR_IN=

# App safety defaults
DEFAULT_LANGUAGE=hi-IN
CLIMATE_SCENARIOS_ENABLED=true
CLIMATE_SCENARIOS_PATH=data/climate_test_scenarios.json
DEVICE_INGEST_ENABLED=false
DEVICE_CONTROL_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth
VITE_SUPABASE_URL=https://ziwcmzxxnialejaifuab.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://ziwcmzxxnialejaifuab.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
